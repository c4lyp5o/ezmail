# ezmail backend — copy to .env for local overrides
# Server/infra settings are read from env ONLY (not user-settable in the UI).

IMAP_HOST=
IMAP_PORT=
IMAP_SECURE=
# ManageSieve defaults to IMAP_HOST and port 4190; TLS is required.
SIEVE_HOST=
SIEVE_PORT=
SIEVE_TLS=starttls
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=

# Auth/session hardening
# Force the session cookie's Secure flag (cookie only ever sent over HTTPS).
# Auto-on when NODE_ENV=production; set to true for reverse-proxy setups where
# TLS terminates upstream (Traefik/Caddy). The cookie is an opaque session
# token, but it grants mailbox access until it expires or you log out.
COOKIE_SECURE=

# Key for encrypting mailbox passwords at rest (server-side sessions and TOTP
# enrollment). Strongly recommended for prod: a stable random 64-char string.
# Changing it invalidates every session and TOTP enrollment.
TOTP_ENC_KEY=

# Legacy fallback for TOTP_ENC_KEY (sessions are no longer JWTs). If neither is
# set, a random key is generated at first boot and persisted in sqlite.
JWT_SECRET=

# Local LLM (ollama/openai-compatible) for email summarization.
# On boot the backend probes this server; if reachable it sets LLM_PRESENT=true
# in sqlite and the frontend shows the summary column. LEAVE EMPTY IF NONE
LLM_SERVER=
LLM_SERVER_APIKEY=
LLM_MODEL=

# Save a copy of every sent message to the IMAP Sent folder. Leave unset/true
# for docker-mailserver/Dovecot (they don't save on SMTP submit); set false for
# servers that already do (e.g. Gmail) to avoid duplicates.
SAVE_SENT=

# HTTP port (default 5000).
PORT=
