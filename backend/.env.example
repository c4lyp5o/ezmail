# ezmail backend — copy to .env for local overrides
# Server/infra settings are read from env ONLY (not user-settable in the UI).

IMAP_HOST=
IMAP_PORT=
IMAP_SECURE=
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=

# Auth/session hardening
# Force the session cookie's Secure flag (cookie only ever sent over HTTPS).
# Auto-on when NODE_ENV=production; set to true for reverse-proxy setups where
# TLS terminates upstream (Traefik/Caddy). The mailbox password rides in this
# cookie for the IMAP/SMTP proxy, so Secure matters.
COOKIE_SECURE=

# JWT signing secret. Strongly recommended for prod: a stable random 64-char
# string. If unset, the server generates one and persists it in sqlite (rotates
# only if the db resets). Set it explicitly to keep sessions valid across boots.
JWT_SECRET=

# Dedicated key for encrypting TOTP-stored mailbox passwords at rest. Independent
# of JWT_SECRET — prefer setting this so a leaked signing key can't decrypt the
# stored password blobs. Falls back to JWT_SECRET if unset.
TOTP_ENC_KEY=

# Local LLM (ollama/openai-compatible) for email summarization.
# On boot the backend probes this server; if reachable it sets LLM_PRESENT=true
# in sqlite and the frontend shows the summary column. LEAVE EMPTY IF NONE
LLM_SERVER=
LLM_SERVER_APIKEY=
LLM_MODEL=
