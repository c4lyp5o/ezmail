# Git
.git
.github
.gitignore

# Dependencies & build output (rebuilt inside the image)
node_modules/
**/node_modules/
frontend/dist/
dist/
backend/data/

# Local config & secrets — never baked into the image
.env
.env.*
!.env.example

# Logs
logs/
*.log

# Editor / OS cruft
.DS_Store
*.swp
.idea/
.vscode/
# Tests and test config (not needed to build or run)
backend/tests/
backend/bunfig.toml
**/*.test.js
**/*.test.jsx
frontend/src/test/
